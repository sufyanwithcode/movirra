# =====================================================================
# MOVIRRA environment example — copy to .env and fill in.
# NEVER commit the real .env. Secrets in prod live in AWS Secrets Manager.
# =====================================================================

# ── App ──
NODE_ENV=development

# ── Web ──
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Database (PostgreSQL) ──
DATABASE_URL=postgresql://movirra:movirra@localhost:5432/movirra?schema=public
POSTGRES_USER=movirra
POSTGRES_PASSWORD=movirra
POSTGRES_DB=movirra

# ── Redis ──
REDIS_URL=redis://localhost:6379

# ── Auth (generate with: openssl rand -base64 32) ──
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── AWS ──
AWS_REGION=
S3_ASSETS_BUCKET=
S3_INGEST_BUCKET=
S3_VOD_BUCKET=
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=

# ── Email (SMTP / SES) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@movirra.example
